{% extends '@CorePhp/layout.html.twig' %}

{% block content %}
  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Vous êtes invité·e sur Gather'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: '<strong>' ~ (dto.inviterName|e) ~ '</strong> vous invite à rejoindre la communauté <strong>' ~ (dto.groupName|e) ~ '</strong>.'
  } only %}

  {% include '@CorePhp/components/_button.html.twig' with {
    url: dto.groupUrl,
    label: 'Voir la communauté'
  } only %}
{% endblock %}
