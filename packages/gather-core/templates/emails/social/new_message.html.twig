{% extends '@CorePhp/layout.html.twig' %}

{% block content %}
  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Nouveau message'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Bonjour <strong>' ~ (dto.recipientName|e) ~ '</strong>, <strong>' ~ (dto.senderName|e) ~ '</strong> vous a écrit :'
  } only %}

  {% if dto.excerpt %}
    {% include '@CorePhp/components/_text.html.twig' with {
      level: 'p',
      tone: 'muted',
      content: '« ' ~ (dto.excerpt|e) ~ ' »'
    } only %}
  {% endif %}

  {% include '@CorePhp/components/_button.html.twig' with {
    url: dto.conversationUrl,
    label: 'Lire la conversation'
  } only %}
{% endblock %}
