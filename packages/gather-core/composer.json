{
    "name": "fagathe/gather-core",
    "description": "Socle partagé de Gather : entités, services, repositories, DTO, enums, e-mails",
    "type": "symfony-bundle",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/fagathe-dev/core-php.git"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "fagathe-dev/core-php": ">=1.1.3",
        "symfony/cache": "^8.1",
        "symfony/clock": "^8.1",
        "symfony/config": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/string": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/validator": "^8.1"
    },
    "suggest": {
        "lexik/jwt-authentication-bundle": "Requis par AuthService et ApiAuthenticator (ignorés par le bundle s'il est absent)"
    },
    "autoload": {
        "psr-4": {
            "Fagathe\\GatherCore\\": "src/"
        }
    }
}
