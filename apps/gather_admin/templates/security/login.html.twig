{% extends 'layouts/auth.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block auth_header %}
  <span class="fw-bold fs-5 d-inline-flex align-items-center gap-2"><span class="avatar avatar-sm"><img src="{{ asset('images/logo.webp') }}" alt=""></span> Gather Admin</span>
{% endblock %}

{% block content %}
  {% if error %}
    <div class="alert alert-soft-danger mb-4" role="alert">
      <i class="ri-close-circle-line alert-icon"></i>
      <div class="alert-content">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    </div>
  {% endif %}

  <form class="d-flex flex-column gap-4" method="post" action="{{ path('admin_login') }}">
    <div>
      <h1 class="h4 mb-1">Connexion au back-office</h1>
      <p class="text-muted mb-0">Espace réservé à l'équipe de modération.</p>
    </div>
    <div>
      <label class="form-label" for="login-username">E-mail ou nom d'utilisateur</label>
      <input class="form-control" id="login-username" type="text" name="_username" value="{{ lastUsername }}" autocomplete="username" required autofocus>
    </div>
    <div>
      <label class="form-label" for="login-password">Mot de passe</label>
      <input class="form-control" id="login-password" type="password" name="_password" autocomplete="current-password" required>
    </div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_login') }}">
    <button type="submit" class="btn btn-primary w-100">Se connecter</button>
  </form>

  <div class="d-flex flex-column gap-2 mt-4">
    <p class="text-muted small text-center mb-0">Déjà connecté sur Gather ?</p>
    <a class="btn btn-outline w-100" href="{{ path('admin_sso_start') }}"><i class="ri-login-circle-line"></i> Continuer avec mon compte Gather</a>
  </div>
{% endblock %}
