{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./assets/ts/*"],
      "@components/*": ["./assets/ts/components/*"]
    }
  },
  "include": ["assets/ts/**/*.ts"]
}
